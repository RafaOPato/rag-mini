# Todas opcionais; sem nenhuma delas o projeto roda em modo extrativo.
# Os scripts Python NÃO leem este arquivo: exporte as variáveis no shell
# (só o docker compose lê um .env sozinho, e só a RAG_PG_PORT).

# Se definida, ask.py chama o Claude pelo SDK oficial. Sem ela, só imprime os trechos.
ANTHROPIC_API_KEY=

# Modelo usado pelo ask.py. Sem valor, vale o padrão do código (ver rag/prompt.py).
ANTHROPIC_MODEL=

# Conexão com o Postgres do docker-compose. Sem valor: postgresql://rag:rag@127.0.0.1:5433/rag
# Nome próprio de propósito: o ingest.py apaga e recria a tabela rag_mini_chunks nesse banco.
RAG_DATABASE_URL=

# Porta do host para o Postgres do docker-compose. Sem valor: 5433.
# Se mudar a porta, defina também RAG_DATABASE_URL com a mesma porta (os scripts Python não leem este arquivo).
RAG_PG_PORT=
